DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Optional. If omitted, the project uses db.sqlite3 automatically.
# DATABASE_URL=postgresql://instaview:change-me@127.0.0.1:5432/instaview
INSTAGRAM_SESSION_USERNAME=
INSTALOADER_SESSIONFILE=
INSTALOADER_SESSION_B64=
GALLERY_DL_INSTAGRAM_COOKIES=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# Must exactly match the callback URI registered in Google Cloud Console.
YOUTUBE_REDIRECT_URI=http://127.0.0.1:8000/youtube/callback/
